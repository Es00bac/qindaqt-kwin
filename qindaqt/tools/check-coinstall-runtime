#!/usr/bin/env python3
"""Run staged fork and installed stock KWin simultaneously on private buses."""
import argparse
import os
import signal
from pathlib import Path
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("stage", type=Path)
parser.add_argument("--stock", type=Path, default=Path("/usr/bin/kwin_wayland"))
args = parser.parse_args()
stage = args.stage.resolve(strict=True)
command = r'''
set -euo pipefail
"$1" --virtual --no-lockscreen --socket "$2" > "$HOME/compositor.log" 2>&1 &
pid=$!
trap "kill $pid 2>/dev/null || true; wait $pid 2>/dev/null || true" EXIT
ready=false
for i in $(seq 1 80); do
    kill -0 "$pid" 2>/dev/null || { cat "$HOME/compositor.log"; exit 1; }
    if busctl --user status "$3" >/dev/null 2>&1; then ready=true; break; fi
    sleep .25
done
"$ready"
busctl --user call "$3" "$4" "$3" currentDesktop
busctl --user list --no-pager > "$HOME/names.txt"
# Keep both compositors alive together long enough to prove independent ownership.
sleep 2
'''
with tempfile.TemporaryDirectory(prefix="qindaqt-kwin-coinstall-") as directory:
    root = Path(directory)
    children = []
    try:
        for name, binary, service, object_path in (
            ("stock", args.stock.resolve(strict=True), "org.kde.KWin", "/KWin"),
            ("fork", stage / "usr/bin/qindaqt-kwin", "org.qindaqt.KWin", "/org/qindaqt/KWin"),
        ):
            environment = os.environ.copy()
            for key in ("DISPLAY", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "SESSION_MANAGER"):
                environment.pop(key, None)
            for key, leaf in {
                "HOME": "home", "XDG_CONFIG_HOME": "config", "XDG_STATE_HOME": "state",
                "XDG_CACHE_HOME": "cache", "XDG_DATA_HOME": "data", "XDG_RUNTIME_DIR": "runtime",
            }.items():
                path = root / name / leaf
                path.mkdir(parents=True, mode=0o700)
                environment[key] = str(path)
            if name == "fork":
                environment.update(
                    LD_LIBRARY_PATH=str(stage / "usr/lib64"),
                    QT_PLUGIN_PATH=str(stage / "usr/lib64/qt6/plugins"),
                    QML2_IMPORT_PATH=str(stage / "usr/lib64/qt6/qml"),
                    XDG_DATA_DIRS=str(stage / "usr/share") + ":/usr/share",
                )
            else:
                # AGENT-NOTE: machines awaiting rollout still have the old consumer
                # plugin installed in stock KWin's namespace. Disable that legacy
                # plugin only in this disposable config; never modify live config.
                (root / name / "config/kwinrc").write_text("[Plugins]\nqindaqt_compositorEnabled=false\n")
            process = subprocess.Popen(
                ["dbus-run-session", "--", "bash", "-c", command, "_", str(binary),
                 "wayland-coinstall-" + name, service, object_path],
                start_new_session=True, env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            children.append((name, process))
        for name, process in children:
            stdout, stderr = process.communicate(timeout=30)
            if process.returncode:
                raise SystemExit(f"{name} failed ({process.returncode}): {stdout}\n{stderr}")
            print(f"{name}: native bus call passed")
        fork_config = root / "fork/config"
        for name in ("kwinrc", "kcminputrc", "kxkbrc", "kwinrulesrc", "kwinoutputconfig.json"):
            assert not (fork_config / name).exists(), f"Fork wrote stock config {name}"
        assert not (root / "stock/config/qindaqt").exists(), "Stock wrote fork config"
        assert (fork_config / "qindaqt/kwinrc").is_file(), "Fork config missing"
        assert "org.qindaqt.KWin" not in (root / "stock/home/names.txt").read_text(), "Stock acquired fork identity"
        print("PASS: stock and staged fork run concurrently with independent buses and config")
    finally:
        # AGENT-GUARD: every private activation dies even if readiness fails.
        for _, process in children:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
